{
  "manifest_version": 3,
  "name": "OnCo AI Solver",
  "version": "1.3.6",
  "description": "OnCo code assistant: local Codex app-server ChatGPT sign-in or optional Gemini/OpenAI API keys",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.on-co.net/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.on-co.net/*"
      ],
      "js": [
        "problem-context.js",
        "content.js",
        "test-feedback.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "solve-problem": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "OnCo 문제 AI 자동 풀이 및 코드 주입"
    },
    "force-paste": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "클립보드 코드 강제 주입 (권한 필요)"
    }
  },
  "key": ""
}
